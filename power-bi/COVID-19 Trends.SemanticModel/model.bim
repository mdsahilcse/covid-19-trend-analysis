          {
            "name": "Report Date",
            "dataType": "dateTime",
            "sourceColumn": "report_date",
            "summarizeBy": "none",
            "lineageTag": "97d6fc35-99f3-5580-b234-975a419e47ac",
            "isHidden": true
          },
          {
            "name": "Location ID",
            "dataType": "string",
            "sourceColumn": "country_id",
            "summarizeBy": "none",
            "lineageTag": "6fc26ba2-ce7c-510d-9dc1-a8f9abcaafba",
            "isHidden": true
          },
          {
            "name": "Daily Cases",
            "dataType": "int64",
            "sourceColumn": "cases_daily",
            "summarizeBy": "none",
            "lineageTag": "876b7819-9ee0-5ac5-9bd3-40b3aa47ba6a",
            "isHidden": true
          },
          {
            "name": "Daily Deaths",
            "dataType": "int64",
            "sourceColumn": "deaths_daily",
            "summarizeBy": "none",
            "lineageTag": "3247ebfb-3adf-5731-a595-cea7a48bd17c",
            "isHidden": true
          },
          {
            "name": "Cumulative Cases",
            "dataType": "int64",
            "sourceColumn": "cases_cumulative",
            "summarizeBy": "none",
            "lineageTag": "b182cf8e-1855-50c4-b791-773643e69df2",
            "isHidden": true
          },
          {
            "name": "Cumulative Deaths",
            "dataType": "int64",
            "sourceColumn": "deaths_cumulative",
            "summarizeBy": "none",
            "lineageTag": "2ddf13a3-00b3-508b-a724-22107c2b56ab",
            "isHidden": true
          },
          {
            "name": "Rolling Cases",
            "dataType": "double",
            "sourceColumn": "cases_avg_7d",
            "summarizeBy": "none",
            "lineageTag": "5b6e06d6-59e5-50f6-b71c-7550737b55c7",
            "isHidden": true
          },
          {
            "name": "Rolling Deaths",
            "dataType": "double",
            "sourceColumn": "deaths_avg_7d",
            "summarizeBy": "none",
            "lineageTag": "fafbb212-7b3a-5abe-a48d-f1093294bc4a",
            "isHidden": true
          },
          {
            "name": "Cases Missing",
            "dataType": "int64",
            "sourceColumn": "cases_missing",
            "summarizeBy": "none",
            "lineageTag": "fbbc307c-4068-5661-8caf-68393bb15105",
            "isHidden": true
          },
          {
            "name": "Deaths Missing",
            "dataType": "int64",
            "sourceColumn": "deaths_missing",
            "summarizeBy": "none",
            "lineageTag": "19ec7a35-a6b7-589f-9db9-d7ab7d9b385f",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Daily Reports",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"\\\" & \"daily.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Types = Table.TransformColumnTypes(Headers, {{\"report_date\", type date}, {\"country_id\", type text}, {\"cases_daily\", Int64.Type}, {\"deaths_daily\", Int64.Type}, {\"cases_cumulative\", Int64.Type}, {\"deaths_cumulative\", Int64.Type}, {\"cases_avg_7d\", type number}, {\"deaths_avg_7d\", type number}, {\"cases_missing\", Int64.Type}, {\"deaths_missing\", Int64.Type}}, \"en-US\")",
                "in",
                "    Types"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "measures": [
          {
            "name": "Reported Cases",
            "expression": "SUM('Daily Reports'[Daily Cases])",
            "formatString": "#,0;(#,0);0",
            "lineageTag": "78caf841-14a2-585d-b533-beac625436a2",
            "description": "Sum of signed change over the dates and reporting locations in context."
          },
          {
            "name": "Cases 7-day Average",
            "expression": "IF(HASONEVALUE('Calendar'[Date]), SUM('Daily Reports'[Rolling Cases]))",
            "formatString": "#,0.0;(#,0.0);0.0",
            "lineageTag": "3d96e6b6-be2e-5680-9976-bb8e90093f26",
            "description": "Trailing seven-day average. Use at day grain. The first six days without a complete window are blank."
          },
          {
            "name": "Cases at End Date",
            "expression": [
              "VAR EndDate = MAX('Calendar'[Date])",
              "RETURN",
              "    CALCULATE(",
              "        SUM('Daily Reports'[Cumulative Cases]),",
              "        KEEPFILTERS('Calendar'[Date] = EndDate)",
              "    )"
            ],
            "formatString": "#,0;(#,0);0",
            "lineageTag": "787ccdc8-7213-5db3-a72e-ba3e96713164",
            "description": "Cumulative reports on the final selected day."
          },
          {
            "name": "Peak Daily Cases",
            "expression": "MAXX(VALUES('Calendar'[Date]), [Reported Cases])",
            "formatString": "#,0;(#,0);0",
            "lineageTag": "8bcfdadf-0c12-56e6-8b1d-602c5d329a70",
            "description": "Maximum signed daily change in the filter context."
          },
          {
            "name": "Reported Deaths",
            "expression": "SUM('Daily Reports'[Daily Deaths])",
            "formatString": "#,0;(#,0);0",
            "lineageTag": "19884009-602a-548c-bae0-c06459e73476",
            "description": "Sum of signed change over the dates and reporting locations in context."
          },
          {
            "name": "Deaths 7-day Average",
            "expression": "IF(HASONEVALUE('Calendar'[Date]), SUM('Daily Reports'[Rolling Deaths]))",
            "formatString": "#,0.0;(#,0.0);0.0",
            "lineageTag": "3aa4c4f2-0e5f-5024-a133-1c7a8455d205",
            "description": "Trailing seven-day average. Use at day grain. The first six days without a complete window are blank."
          },
          {
            "name": "Deaths at End Date",
            "expression": [
              "VAR EndDate = MAX('Calendar'[Date])",
              "RETURN",
              "    CALCULATE(",
              "        SUM('Daily Reports'[Cumulative Deaths]),",
              "        KEEPFILTERS('Calendar'[Date] = EndDate)",
              "    )"
            ],
            "formatString": "#,0;(#,0);0",
            "lineageTag": "3f8c4f93-803f-52c3-92f7-67bf272964aa",
            "description": "Cumulative reports on the final selected day."
          },
          {
            "name": "Peak Daily Deaths",
            "expression": "MAXX(VALUES('Calendar'[Date]), [Reported Deaths])",
            "formatString": "#,0;(#,0);0",
            "lineageTag": "c87d3b46-a7ee-5c68-9cab-02c15e85a11e",
            "description": "Maximum signed daily change in the filter context."
          }
        ]
      }
    ],
    "relationships": [
