        ],
        "partitions": [
          {
            "name": "Location",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"\\\" & \"countries.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Types = Table.TransformColumnTypes(Headers, {{\"country_id\", type text}, {\"country_name\", type text}, {\"iso3\", type text}, {\"latitude\", type number}, {\"longitude\", type number}}, \"en-US\")",
                "in",
                "    Types"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "Calendar",
        "lineageTag": "646f8164-2c12-52ab-94a0-0fa7689dd71c",
        "columns": [
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "report_date",
            "summarizeBy": "none",
            "lineageTag": "1f93e7fb-a3c8-5ac5-9581-3fa532dd7f23",
            "formatString": "yyyy-mm-dd",
            "isKey": true
          },
          {
            "name": "Week Starting",
            "dataType": "dateTime",
            "sourceColumn": "week_start",
            "summarizeBy": "none",
            "lineageTag": "e064a4fb-ed1c-5b7b-b4d5-d36689659edc",
            "formatString": "yyyy-mm-dd"
          },
          {
            "name": "Reporting Year",
            "dataType": "int64",
            "sourceColumn": "reporting_year",
            "summarizeBy": "none",
            "lineageTag": "0ec61d1a-1f8d-5087-a719-baf70b2c0cea",
            "formatString": "0"
          }
        ],
        "partitions": [
          {
            "name": "Calendar",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"\\\" & \"dates.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Types = Table.TransformColumnTypes(Headers, {{\"report_date\", type date}, {\"week_start\", type date}}, \"en-US\"),",
                "    ReportingYear = Table.AddColumn(Types, \"reporting_year\", each Date.Year(Date.AddDays([week_start], 3)), Int64.Type)",
                "in",
                "    ReportingYear"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "dataCategory": "Time",
        "hierarchies": [
          {
            "name": "Reporting Date",
            "lineageTag": "ab96ea22-db24-598d-8847-5a44f59bbf19",
            "levels": [
              {
                "name": "Reporting Year",
                "ordinal": 0,
                "column": "Reporting Year",
                "lineageTag": "7d31aaa6-1767-5c94-8cbf-5775f0407123"
              },
              {
                "name": "Week Starting",
